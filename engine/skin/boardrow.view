#import "skin://theme.view"

// One titled, horizontally scrolling row of posters
widget(container_y, {

  widget(label, {
    caption: $self.title;
    font: "dataroot://res/fonts/ps3mio/title.ttf";
    size: 1.9em;
    margin: [1em, 1em, 0, 0.3em];
  });

  widget(list_x, {
    chaseFocus: true;
    height: 15.6em;
    margin: [0.5em, 0, 0.5em, 0];

    cloner($self.items, loader, {
      source: "skin://poster.view";
    });
  });
});
