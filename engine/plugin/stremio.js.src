/*
 * Stremio for Movian (PS3)
 * ------------------------
 * A tiny Stremio *addon-protocol* client written as a Movian plugin.
 *   - UI           : Movian's own GLW skin (controller friendly, no extra animations)
 *   - Player       : Movian's built-in player (libav + PS3 hardware decoder)
 *   - Torrents     : Movian's built-in BitTorrent backend (magnet: URLs)
 *   - Addons       : synced from the Stremio account, NEVER edited on the console
 *
 * ES5 only (Duktape). No external libraries.
 */
(function () {
  var page = require('movian/page');
  var http = require('movian/http');
  var settings = require('movian/settings');
  var store = require('movian/store');
  var service = require('movian/service');
  var popup = require('native/popup');

  var PFX = 'stremio:';
  var UA = 'Stremio-PS3/0.1 (Movian)';
  var CINEMETA = 'https://v3-cinemeta.strem.io/manifest.json';
  var SYNC_EVERY_MS = 6 * 3600 * 1000;
  var DEFAULT_TRACKERS = [
    'udp://tracker.opentrackr.org:1337/announce',
    'udp://open.tracker.cl:1337/announce',
    'udp://tracker.torrent.eu.org:451/announce',
    'udp://exodus.desync.com:6969/announce'
  ];

  var I18N = /*I18N*/{};

  var st = store.create('stremio_state');
  var LOGO = (typeof Plugin !== 'undefined' && Plugin.path) ? Plugin.path + 'logo.png' : null;

  // ------------------------------------------------------------------
  // Settings
  // ------------------------------------------------------------------
  var cfg = {
    lang: 'en',
    api: 'https://api.strem.io',
    link: 'https://link.stremio.com',
    relay: '',
    manual: '',
    grid: true,
    maxStreams: 60
  };

  var S = new settings.globalSettings('stremio', 'Stremio', LOGO,
    'Stremio client for Movian');
  S.createMultiOpt('lang', 'Language', [
    ['en', 'English', true], ['ar', 'Arabic (may not shape correctly)'],
    ['fr', 'Francais'], ['es', 'Espanol'], ['de', 'Deutsch'],
    ['it', 'Italiano'], ['pt', 'Portugues'], ['tr', 'Turkce']
  ], function (v) { cfg.lang = v; });
  S.createBool('grid', 'Poster grid in catalogs', true, function (v) { cfg.grid = v; });
  S.createInt('maxStreams', 'Max streams per addon', 60, 5, 200, 5, '',
    function (v) { cfg.maxStreams = v; });
  S.createDivider('Advanced');
  S.createString('api', 'Stremio API server', 'https://api.strem.io',
    function (v) { cfg.api = String(v).replace(/\/+$/, ''); });
  S.createString('link', 'Stremio link server', 'https://link.stremio.com',
    function (v) { cfg.link = String(v).replace(/\/+$/, ''); });
  S.createString('relay', 'HTTP relay prefix (only if HTTPS fails)', '',
    function (v) { cfg.relay = String(v); });
  S.createString('manual', 'Extra addon manifest URLs (comma separated)', '',
    function (v) { cfg.manual = String(v); _addons = null; });
  S.createAction('sync', 'Sync addons from my Stremio account', function () {
    var n = syncAddons();
    popup.notify(typeof n === 'number' ? T('synced') + ': ' + n : T('need_login'), 4);
  });
  S.createAction('refresh', 'Refresh (re-sync addons, clear cache)', function () {
    var n = refreshAll();
    popup.notify(typeof n === 'number' ? T('synced') + ': ' + n : T('need_login'), 4);
  });
  S.createAction('logout', 'Log out', function () {
    st.authKey = '';
    st.addons = '[]';
    _addons = null;
    popup.notify(T('logged_out'), 3);
  });

  // ------------------------------------------------------------------
  // Helpers
  // ------------------------------------------------------------------
  var lastErr = '';
  var _addons = null;
  var metaCache = {};
  var metaCacheKeys = [];

  function T(k) {
    var d = I18N[cfg.lang] || I18N.en || {};
    if (d[k]) return d[k];
    return (I18N.en && I18N.en[k]) || k;
  }

  // Movian's bundled font has no emoji / symbol glyphs -> strip them
  function clean(s) {
    if (s === undefined || s === null) return '';
    return String(s)
      .replace(/[\uD800-\uDFFF]/g, '')
      .replace(/[\u2190-\u2BFF\uFE0F\u200D]/g, '')
      .replace(/[ \t]+/g, ' ')
      .replace(/^\s+|\s+$/g, '');
  }
  function oneLine(s) { return clean(s).replace(/\s*[\r\n]+\s*/g, ' | '); }
  function firstLine(s) { return clean(s).split(/[\r\n]+/)[0] || ''; }

  function viaRelay(url) {
    if (cfg.relay && /^https?:/i.test(url)) return cfg.relay + encodeURIComponent(url);
    return url;
  }

  function fetchJSON(url, opt) {
    opt = opt || {};
    var ctrl = {
      headers: { 'User-Agent': UA, 'Accept': 'application/json' },
      compression: true,
      noFail: true
    };
    if (opt.cache) { ctrl.caching = true; ctrl.cacheTime = opt.cache; }
    if (opt.post !== undefined) {
      ctrl.postdata = JSON.stringify(opt.post);
      ctrl.headers['Content-Type'] = 'application/json';
    }
    try {
      var r = http.request(viaRelay(url), ctrl);
      var txt = r.toString();
      if (!txt) { lastErr = 'empty response (' + r.statuscode + ')'; return null; }
      return JSON.parse(txt);
    } catch (e) {
      lastErr = String(e);
      return null;
    }
  }

  function api(method, body) {
    return fetchJSON(cfg.api + '/api/' + method, { post: body });
  }

  function enc(s) { return encodeURIComponent(s); }
  function encId(id) { return enc(id).replace(/%3A/gi, ':'); }
  function decode(s) { try { return decodeURIComponent(s); } catch (e) { return s; } }

  function slim(m) {
    var cats = [];
    (m.catalogs || []).forEach(function (c) {
      cats.push({ type: c.type, id: c.id, name: c.name, extra: c.extra,
                  extraSupported: c.extraSupported, extraRequired: c.extraRequired });
    });
    return { id: m.id, name: m.name, version: m.version, description: m.description,
             types: m.types, idPrefixes: m.idPrefixes, resources: m.resources,
             catalogs: cats };
  }

  function baseOf(url) {
    return String(url).replace(/\/manifest\.json.*$/, '').replace(/\/+$/, '');
  }

  // ------------------------------------------------------------------
  // Addons (synced from the account, stored locally)
  // ------------------------------------------------------------------
  function syncAddons() {
    if (!st.authKey) return 'login';
    var r = api('addonCollectionGet',
                { type: 'AddonCollectionGet', authKey: st.authKey, update: true });
    if (!r || !r.result || !r.result.addons) {
      if (r && r.error) lastErr = (r.error.message || 'api error');
      return 'error';
    }
    var out = [];
    r.result.addons.forEach(function (a) {
      if (a && a.manifest && a.transportUrl) out.push({ url: a.transportUrl, m: slim(a.manifest) });
    });
    st.addons = JSON.stringify(out);
    st.syncedAt = String(new Date().getTime());
    _addons = null;
    return out.length;
  }

  function getAddons() {
    if (_addons) return _addons;
    var list = [];
    try { list = JSON.parse(st.addons || '[]'); } catch (e) { list = []; }
    var seen = {};
    list.forEach(function (a) { seen[a.url] = 1; });
    String(cfg.manual || '').split(/[\s,]+/).forEach(function (u) {
      if (!u || seen[u]) return;
      var m = fetchJSON(u, { cache: 3600 });
      if (m && m.id) { list.push({ url: u, m: slim(m) }); seen[u] = 1; }
    });
    if (!list.length) {
      var cm = fetchJSON(CINEMETA, { cache: 3600 });
      if (cm && cm.id) list.push({ url: CINEMETA, m: slim(cm) });
    }
    list.forEach(function (a) { a.base = baseOf(a.url); });
    _addons = list;
    return list;
  }

  function resInfo(m, name) {
    var rs = m.resources || [];
    for (var i = 0; i < rs.length; i++) {
      var r = rs[i];
      if (typeof r === 'string') {
        if (r === name) return { types: m.types, idPrefixes: m.idPrefixes };
      } else if (r && r.name === name) {
        return { types: r.types || m.types, idPrefixes: r.idPrefixes || m.idPrefixes };
      }
    }
    return null;
  }

  function supports(a, res, type, id) {
    var ri = resInfo(a.m, res);
    if (!ri) return false;
    if (ri.types && ri.types.length) {
      var ok = false;
      for (var i = 0; i < ri.types.length; i++) if (ri.types[i] === type) ok = true;
      if (!ok) return false;
    }
    if (ri.idPrefixes && ri.idPrefixes.length && id) {
      var ok2 = false;
      for (var j = 0; j < ri.idPrefixes.length; j++)
        if (String(id).indexOf(ri.idPrefixes[j]) === 0) ok2 = true;
      if (!ok2) return false;
    }
    return true;
  }

  function resUrl(a, res, type, id) {
    return a.base + '/' + res + '/' + type + '/' + encId(id) + '.json';
  }

  // ------------------------------------------------------------------
  // Catalog helpers
  // ------------------------------------------------------------------
  function catInfo(c) {
    var sup = {}, req = {}, genres = null;
    (c.extra || []).forEach(function (e) {
      sup[e.name] = 1;
      if (e.isRequired) req[e.name] = 1;
      if (e.name === 'genre' && e.options && e.options.length) genres = e.options;
    });
    (c.extraSupported || []).forEach(function (n) { sup[n] = 1; });
    (c.extraRequired || []).forEach(function (n) { req[n] = 1; });
    return { sup: sup, req: req, genres: genres };
  }

  function browsable(c) {
    var i = catInfo(c);
    for (var k in i.req) if (k !== 'genre' && k !== 'skip') return false;
    return true;
  }

  function catUrl(a, c, extra) {
    var p = [];
    for (var k in extra) {
      if (extra[k] !== undefined && extra[k] !== null && extra[k] !== '')
        p.push(k + '=' + enc(extra[k]));
    }
    return a.base + '/catalog/' + c.type + '/' + enc(c.id) +
      (p.length ? '/' + p.join('&') : '') + '.json';
  }

  function typeName(t) {
    if (t === 'movie') return T('movie');
    if (t === 'series') return T('series');
    if (t === 'channel') return T('channel');
    return t;
  }

  function catTitle(a, c) {
    return clean(c.name || c.id) + ' - ' + typeName(c.type) + '  [' + clean(a.m.name) + ']';
  }

  function hint(pg) {
    pg.appendPassiveItem('separator', '', { title: T('hint') });
  }

  function img(u) { return u ? viaRelay(u) : undefined; }

  function metaTitle(m) {
    var t = clean(m.name || m.id);
    if (m.releaseInfo) t += ' (' + clean(m.releaseInfo) + ')';
    else if (m.year) t += ' (' + m.year + ')';
    return t;
  }

  function appendMeta(pg, m, fallbackType) {
    var type = m.type || fallbackType;
    var md = { title: metaTitle(m), icon: img(m.poster || m.logo) };
    var d = [];
    if (m.imdbRating) { md.rating = Math.round(parseFloat(m.imdbRating) * 10); d.push('IMDb ' + m.imdbRating); }
    if (m.genres && m.genres.length) d.push(clean(m.genres.join(', ')));
    if (m.description) d.push(clean(m.description));
    md.description = d.join('\n');
    return pg.appendItem(PFX + 'meta:' + type + ':' + enc(m.id), 'directory', md);
  }

  // ------------------------------------------------------------------
  // Refresh + recent searches (typing on a controller is slow)
  // ------------------------------------------------------------------
  function refreshAll() {
    metaCache = {};
    metaCacheKeys = [];
    _addons = null;
    var n = st.authKey ? syncAddons() : 'login';
    return n;
  }

  function getRecents() {
    try { var r = JSON.parse(st.recent || '[]'); return r.length ? r : []; } catch (e) { return []; }
  }
  function addRecent(q) {
    var r = getRecents(), out = [q];
    r.forEach(function (x) { if (x !== q && out.length < 8) out.push(x); });
    st.recent = JSON.stringify(out);
  }

  new page.Route('^stremio:refresh$', function (pg) {
    pg.type = 'directory';
    pg.metadata.title = T('refresh');
    pg.loading = true;
    var n = refreshAll();
    pg.loading = false;
    if (typeof n === 'number') popup.notify(T('synced') + ': ' + n, 3);
    else if (n === 'error') popup.notify(T('net_error') + (lastErr ? ': ' + lastErr : ''), 5);
    pg.redirect(PFX + 'start');
  });

  // ------------------------------------------------------------------
  // Home / Board
  // ------------------------------------------------------------------
  new page.Route('^stremio:start$', function (pg) {
    pg.type = 'directory';
    pg.metadata.title = 'ps3mio';
    pg.metadata.logo = LOGO;
    hint(pg);
    pg.appendAction(T('refresh'), function () { pg.redirect(PFX + 'refresh'); });
    pg.loading = true;

    if (st.authKey) {
      var last = parseInt(st.syncedAt || '0', 10);
      if (!last || new Date().getTime() - last > SYNC_EVERY_MS) syncAddons();
    }
    var addons = getAddons();
    pg.loading = false;

    if (!st.authKey) {
      pg.appendItem(PFX + 'login', 'directory', { title: T('phone_login') });
      pg.appendItem(PFX + 'loginmail', 'directory', { title: T('email_login') });
      pg.appendPassiveItem('separator', '', { title: T('not_logged') });
    } else {
      pg.appendItem(PFX + 'continue', 'directory', { title: T('cw') });
      pg.appendItem(PFX + 'library', 'directory', { title: T('library') });
    }
    pg.appendItem(PFX + 'searchbox', 'directory', { title: T('search') });

    pg.appendPassiveItem('separator', '', { title: T('board') + ' / ' + T('discover') });
    var n = 0;
    addons.forEach(function (a, ai) {
      (a.m.catalogs || []).forEach(function (c, ci) {
        if (!browsable(c)) return;
        pg.appendItem(PFX + 'cat:' + ai + ':' + ci, 'directory', { title: catTitle(a, c) });
        n++;
      });
    });
    if (!n) pg.appendPassiveItem('separator', '', { title: lastErr ? T('net_error') + ': ' + lastErr : T('no_results') });

    pg.appendPassiveItem('separator', '', {});
    pg.appendItem(PFX + 'refresh', 'directory', { title: T('refresh') });
    pg.appendItem(PFX + 'addons', 'directory', { title: T('addons') });
  });

  // ------------------------------------------------------------------
  // Catalog (with paging + genre filter)
  // ------------------------------------------------------------------
  function showCatalog(pg, ai, ci, genre) {
    var addons = getAddons();
    var a = addons[ai];
    var c = a && a.m.catalogs[ci];
    pg.type = 'directory';
    if (!c) { pg.error('Catalog not found - sync addons again'); return; }
    var info = catInfo(c);
    pg.metadata.title = clean(c.name || c.id) + ' - ' + typeName(c.type);
    if (cfg.grid) pg.model.contents = 'grid';
    if (!genre && info.req.genre && info.genres) genre = info.genres[0];

    if (info.genres) {
      pg.appendItem(PFX + 'genres:' + ai + ':' + ci, 'directory',
        { title: T('genre') + ': ' + (genre || T('all')) });
    }

    var skip = 0;
    var canSkip = !!info.sup.skip;
    pg.loading = true;
    function load() {
      var extra = {};
      if (genre) extra.genre = genre;
      if (skip) extra.skip = skip;
      var r = fetchJSON(catUrl(a, c, extra), { cache: 120 });
      pg.loading = false;
      if (!r || !r.metas) {
        if (!skip) pg.error(T('net_error') + (lastErr ? ': ' + lastErr : ''));
        pg.haveMore(false);
        return;
      }
      r.metas.forEach(function (m) { appendMeta(pg, m, c.type); });
      skip += r.metas.length;
      pg.haveMore(canSkip && r.metas.length > 0);
    }
    pg.asyncPaginator = load;
    load();
  }

  new page.Route('^stremio:cat:(\\d+):(\\d+)$', function (pg, ai, ci) {
    showCatalog(pg, parseInt(ai, 10), parseInt(ci, 10), null);
  });
  new page.Route('^stremio:catg:(\\d+):(\\d+):(.+)$', function (pg, ai, ci, g) {
    showCatalog(pg, parseInt(ai, 10), parseInt(ci, 10), decode(g));
  });
  new page.Route('^stremio:genres:(\\d+):(\\d+)$', function (pg, ai, ci) {
    var a = getAddons()[parseInt(ai, 10)];
    var c = a && a.m.catalogs[parseInt(ci, 10)];
    pg.type = 'directory';
    pg.metadata.title = T('genre');
    hint(pg);
    if (!c) return;
    pg.appendItem(PFX + 'cat:' + ai + ':' + ci, 'directory', { title: T('all') });
    var info = catInfo(c);
    (info.genres || []).forEach(function (g) {
      pg.appendItem(PFX + 'catg:' + ai + ':' + ci + ':' + enc(g), 'directory', { title: clean(g) });
    });
  });

  // ------------------------------------------------------------------
  // Search (own page + Movian global searcher)
  // ------------------------------------------------------------------
  function searchInto(pg, query) {
    var addons = getAddons();
    var total = 0;
    pg.loading = true;
    addons.forEach(function (a) {
      (a.m.catalogs || []).forEach(function (c) {
        var info = catInfo(c);
        if (!info.sup.search) return;
        var r = fetchJSON(catUrl(a, c, { search: query }), { cache: 60 });
        if (!r || !r.metas || !r.metas.length) return;
        pg.appendPassiveItem('separator', '',
          { title: clean(c.name || c.id) + ' - ' + typeName(c.type) + ' [' + clean(a.m.name) + ']' });
        r.metas.slice(0, 30).forEach(function (m) { appendMeta(pg, m, c.type); total++; });
      });
    });
    pg.loading = false;
    if (!total) pg.appendPassiveItem('separator', '', { title: T('no_results') });
  }

  new page.Route('^stremio:searchbox$', function (pg) {
    pg.type = 'directory';
    pg.metadata.title = T('search');
    hint(pg);
    pg.appendAction(T('search_btn'), function () {
      var r = popup.textDialog(T('search') + ':', true, true);
      if (r && !r.rejected && r.input) { addRecent(r.input); pg.redirect(PFX + 'q:' + enc(r.input)); }
    });
    var rec = getRecents();
    if (rec.length) pg.appendPassiveItem('separator', '', { title: T('recent') });
    rec.forEach(function (q) { pg.appendItem(PFX + 'q:' + enc(q), 'directory', { title: clean(q) }); });
  });
  new page.Route('^stremio:q:(.*)$', function (pg, q) {
    pg.type = 'directory';
    var query = decode(q);
    pg.metadata.title = T('search') + ': ' + query;
    if (cfg.grid) pg.model.contents = 'grid';
    searchInto(pg, query);
  });
  new page.Searcher('Stremio', LOGO, function (pg, query) {
    pg.type = 'directory';
    searchInto(pg, query);
  });

  // ------------------------------------------------------------------
  // Meta (details) -> seasons -> episodes -> streams
  // ------------------------------------------------------------------
  function getMeta(type, id) {
    var key = type + '|' + id;
    if (metaCache[key]) return metaCache[key];
    var addons = getAddons();
    for (var i = 0; i < addons.length; i++) {
      if (!supports(addons[i], 'meta', type, id)) continue;
      var r = fetchJSON(resUrl(addons[i], 'meta', type, id), { cache: 300 });
      if (r && r.meta) {
        metaCache[key] = r.meta;
        metaCacheKeys.push(key);
        if (metaCacheKeys.length > 4) delete metaCache[metaCacheKeys.shift()];
        return r.meta;
      }
    }
    return null;
  }

  function seasonsOf(meta) {
    var map = {}, list = [];
    (meta.videos || []).forEach(function (v) {
      var s = (v.season === undefined || v.season === null) ? 0 : parseInt(v.season, 10);
      if (isNaN(s)) s = 0;
      if (!map[s]) { map[s] = []; list.push(s); }
      map[s].push(v);
    });
    list.sort(function (x, y) { return x - y; });
    list.forEach(function (s) {
      map[s].sort(function (x, y) {
        return (parseInt(x.episode || x.number || 0, 10)) - (parseInt(y.episode || y.number || 0, 10));
      });
    });
    return { list: list, map: map };
  }

  function metaDescription(m) {
    var d = [];
    var head = [];
    if (m.releaseInfo || m.year) head.push(clean(m.releaseInfo || m.year));
    if (m.runtime) head.push(clean(m.runtime));
    if (m.imdbRating) head.push('IMDb ' + m.imdbRating);
    if (head.length) d.push(head.join('  -  '));
    if (m.genres && m.genres.length) d.push(clean(m.genres.join(', ')));
    if (m.description) d.push(clean(m.description));
    if (m.director && m.director.length) d.push(T('director') + ': ' + clean([].concat(m.director).join(', ')));
    if (m.cast && m.cast.length) d.push(T('cast') + ': ' + clean(m.cast.slice(0, 8).join(', ')));
    return d.join('\n');
  }

  new page.Route('^stremio:meta:([^:]+):(.+)$', function (pg, type, eid) {
    var id = decode(eid);
    pg.type = 'directory';
    pg.loading = true;
    var meta = getMeta(type, id);
    pg.loading = false;
    hint(pg);
    if (!meta) {
      // No meta addon: still allow streams for the bare id
      pg.metadata.title = id;
      pg.appendItem(PFX + 'streams:' + type + ':' + eid + ':' + enc(id), 'directory', { title: T('watch') });
      return;
    }
    pg.metadata.title = clean(meta.name || id);
    pg.metadata.icon = img(meta.poster);
    var desc = metaDescription(meta);
    var icon = img(meta.poster);

    var seasons = (type !== 'movie' && meta.videos && meta.videos.length) ? seasonsOf(meta) : null;
    if (!seasons) {
      pg.appendItem(PFX + 'streams:' + type + ':' + eid + ':' + enc(meta.name || id), 'directory',
        { title: T('watch'), icon: icon, description: desc });
      return;
    }
    pg.appendPassiveItem('separator', '', { title: clean(meta.name) });
    if (desc) pg.appendPassiveItem('separator', '', { title: firstLine(desc) });
    seasons.list.forEach(function (s) {
      pg.appendItem(PFX + 'season:' + type + ':' + eid + ':' + s, 'directory', {
        title: (s === 0 ? T('special') : T('season') + ' ' + s) + '  (' + seasons.map[s].length + ')',
        icon: icon, description: desc
      });
    });
  });

  new page.Route('^stremio:season:([^:]+):([^:]+):(\\d+)$', function (pg, type, eid, s) {
    var id = decode(eid);
    var meta = getMeta(type, id);
    pg.type = 'directory';
    pg.metadata.title = clean(meta ? meta.name : id) + ' - ' + (parseInt(s, 10) === 0 ? T('special') : T('season') + ' ' + s);
    hint(pg);
    if (!meta) return;
    var seasons = seasonsOf(meta);
    (seasons.map[parseInt(s, 10)] || []).forEach(function (v) {
      var ep = v.episode || v.number;
      var title = (ep ? ep + '. ' : '') + clean(v.title || v.name || T('episode'));
      var d = [];
      if (v.released) d.push(String(v.released).substr(0, 10));
      if (v.overview || v.description) d.push(clean(v.overview || v.description));
      pg.appendItem(PFX + 'streams:' + type + ':' + enc(v.id) + ':' +
        enc(clean(meta.name) + ' S' + s + 'E' + (ep || '?')), 'directory',
        { title: title, icon: img(v.thumbnail), description: d.join('\n') });
    });
  });

  // ------------------------------------------------------------------
  // Streams
  // ------------------------------------------------------------------
  function magnetOf(s, title, se) {
    var m = 'magnet:?xt=urn:btih:' + s.infoHash;
    if (title) m += '&dn=' + enc(title);
    var trackers = [];
    (s.sources || []).forEach(function (x) {
      if (typeof x === 'string' && x.indexOf('tracker:') === 0) trackers.push(x.substr(8));
    });
    if (!trackers.length) trackers = DEFAULT_TRACKERS;
    trackers.forEach(function (t) { m += '&tr=' + enc(t); });
    // m7io extensions understood by the patched bittorrent backend: pick the right file of a pack
    if (s.fileIdx !== undefined && s.fileIdx !== null && !isNaN(parseInt(s.fileIdx, 10))) m += '&m7idx=' + parseInt(s.fileIdx, 10);
    else if (se) m += '&m7se=' + se.season + ':' + se.episode;
    return m;
  }

  // Torrentio & co. put seeders / size in the stream title using emoji; the console font has none.
  function mapEmoji(t) {
    return String(t === undefined || t === null ? '' : t)
      .replace(/\uD83D\uDC64/g, 'Seeds ')
      .replace(/\uD83D\uDC65/g, 'Peers ')
      .replace(/\uD83D\uDCBE/g, 'Size ')
      .replace(/\u2699\uFE0F?/g, 'Src ');
  }

  function fmtSize(b) {
    b = parseFloat(b);
    if (isNaN(b) || b <= 0) return '';
    if (b >= 1073741824) return (b / 1073741824).toFixed(2) + ' GB';
    if (b >= 1048576) return Math.round(b / 1048576) + ' MB';
    return Math.round(b / 1024) + ' KB';
  }

  // One list row per stream:  [4k] Seeds 120 | 2.1 GB | ThePirateBay - file name
  function streamRow(a, s) {
    var nameLines = clean(mapEmoji(s.name || a.m.name)).split(/[\r\n]+/);
    var qual = nameLines.slice(1).join(' ');
    var text = clean(mapEmoji(s.title || s.description || ''));
    var bh = s.behaviorHints || {};
    var seedM = /Seeds\s*(\d+)/i.exec(text);
    var sizeM = /Size\s*([\d.,]+\s*[KMGT]i?B)/i.exec(text);
    var srcM = /Src\s*([^\r\n]+)/i.exec(text);
    var seeders = seedM ? parseInt(seedM[1], 10) : ((s.seeders !== undefined && s.seeders !== null) ? parseInt(s.seeders, 10) : null);
    var size = sizeM ? sizeM[1] : fmtSize(bh.videoSize);
    var src = srcM ? clean(srcM[1]) : '';
    var fname = clean(bh.filename || text.split(/[\r\n]+/)[0] || '');
    if (/^(Seeds|Size|Src)\b/i.test(fname)) fname = '';
    if (fname.length > 64) fname = fname.substr(0, 61) + '...';
    var info = [];
    if (seeders !== null && !isNaN(seeders)) info.push('Seeds ' + seeders);
    if (size) info.push(size);
    if (src) info.push(src);
    var title = (qual ? '[' + qual + '] ' : '') + info.join(' | ');
    if (fname) title += (title ? ' - ' : '') + fname;
    if (!title) title = oneLine(nameLines[0] || a.m.name);
    return { title: title, description: text, seeders: seeders, size: size };
  }

  function gatherSubs(type, id) {
    var out = [];
    getAddons().forEach(function (a) {
      if (!supports(a, 'subtitles', type, id)) return;
      var r = fetchJSON(resUrl(a, 'subtitles', type, id), { cache: 300 });
      if (!r || !r.subtitles) return;
      r.subtitles.slice(0, 12).forEach(function (x) {
        if (!x.url) return;
        out.push({ title: clean(x.lang || 'sub') + ' - ' + clean(a.m.name),
                   url: x.url, language: x.lang, source: clean(a.m.name) });
      });
    });
    return out.slice(0, 24);
  }

  function seasonEpisodeOf(id) {
    var p = String(id).split(':');
    if (p.length >= 3) {
      var s = parseInt(p[p.length - 2], 10), e = parseInt(p[p.length - 1], 10);
      if (!isNaN(s) && !isNaN(e)) return { season: s, episode: e };
    }
    return null;
  }

  new page.Route('^stremio:streams:([^:]+):([^:]+):(.*)$', function (pg, type, eid, etitle) {
    var id = decode(eid);
    var title = decode(etitle) || id;
    pg.type = 'directory';
    pg.metadata.title = clean(title);
    hint(pg);
    pg.loading = true;

    var subs = null;
    var se = (type === 'series') ? seasonEpisodeOf(id) : null;
    var total = 0;

    function videoItem(url, row, s) {
      if (subs === null) subs = gatherSubs(type, id);
      var vp = {
        title: clean(title),
        canonicalUrl: url,
        sources: [{ url: url }],
        subtitles: (s.subtitles && s.subtitles.length ? s.subtitles.map(function (x) {
          return { title: clean(x.lang || 'sub'), url: x.url, language: x.lang, source: 'stream' };
        }) : []).concat(subs),
        no_fs_scan: 1
      };
      if (se) { vp.season = se.season; vp.episode = se.episode; }
      pg.appendItem('videoparams:' + JSON.stringify(vp), 'video',
        { title: row.title, description: row.description });
    }

    getAddons().forEach(function (a) {
      if (!supports(a, 'stream', type, id)) return;
      var r = fetchJSON(resUrl(a, 'stream', type, id), { cache: 30 });
      if (!r || !r.streams || !r.streams.length) return;
      var added = 0;
      r.streams.slice(0, cfg.maxStreams).forEach(function (s) {
        var row = streamRow(a, s);
        var url = null;
        if (s.url && /^magnet:/i.test(s.url)) {
          url = 'torrent:video:' + s.url;
        } else if (s.infoHash) {
          url = 'torrent:video:' + magnetOf(s, title, se);
        } else if (s.url && /^https?:/i.test(s.url)) {
          url = viaRelay(s.url);
        }
        // ytId / externalUrl streams are not playable on the console -> skipped
        if (!url) return;
        if (!added) pg.appendPassiveItem('separator', '', { title: clean(a.m.name) });
        videoItem(url, row, s);
        added++; total++;
      });
    });
    pg.loading = false;
    if (!total) pg.appendPassiveItem('separator', '', { title: T('no_streams') });
  });

  // ------------------------------------------------------------------
  // Library / Continue watching (read-only)
  // ------------------------------------------------------------------
  function loadLibrary() {
    if (!st.authKey) return null;
    var r = api('datastoreGet', { authKey: st.authKey, collection: 'libraryItem', ids: [], all: true });
    if (!r || !r.result) return null;
    var out = [];
    r.result.forEach(function (it) { if (it && !it.removed) out.push(it); });
    out.sort(function (x, y) { return String(y._mtime || '').localeCompare(String(x._mtime || '')); });
    return out;
  }

  new page.Route('^stremio:library$', function (pg) {
    pg.type = 'directory';
    pg.metadata.title = T('library');
    if (cfg.grid) pg.model.contents = 'grid';
    pg.loading = true;
    var items = loadLibrary();
    pg.loading = false;
    if (!items) { pg.error(st.authKey ? T('net_error') + (lastErr ? ': ' + lastErr : '') : T('need_login')); return; }
    items.forEach(function (it) {
      appendMeta(pg, { id: it._id, type: it.type, name: it.name, poster: it.poster }, it.type);
    });
  });

  new page.Route('^stremio:continue$', function (pg) {
    pg.type = 'directory';
    pg.metadata.title = T('cw');
    if (cfg.grid) pg.model.contents = 'grid';
    pg.loading = true;
    var items = loadLibrary();
    pg.loading = false;
    if (!items) { pg.error(st.authKey ? T('net_error') + (lastErr ? ': ' + lastErr : '') : T('need_login')); return; }
    items.forEach(function (it) {
      var s = it.state || {};
      if (!s.timeOffset || s.timeOffset <= 0) return;
      var pct = s.duration ? Math.round(100 * s.timeOffset / s.duration) : 0;
      var vid = (it.type === 'series' && s.video_id) ? s.video_id : it._id;
      var label = clean(it.name) + (it.type === 'series' && s.video_id ? '  (' + clean(s.video_id.split(':').slice(1).join('x')) + ')' : '') +
        (pct ? '  ' + pct + '%' : '');
      pg.appendItem(PFX + 'streams:' + it.type + ':' + enc(vid) + ':' + enc(it.name), 'directory',
        { title: label, icon: img(it.poster) });
    });
  });

  // ------------------------------------------------------------------
  // Addons page (sync only - editing is done from phone / PC)
  // ------------------------------------------------------------------
  new page.Route('^stremio:addons$', function (pg) {
    pg.type = 'directory';
    pg.metadata.title = T('addons');
    hint(pg);
    pg.appendPassiveItem('separator', '', { title: T('addons_help') });
    pg.appendAction(T('sync'), function () {
      pg.loading = true;
      var n = syncAddons();
      pg.loading = false;
      if (typeof n === 'number') { popup.notify(T('synced') + ': ' + n, 4); pg.redirect(PFX + 'addons'); }
      else popup.notify(n === 'login' ? T('need_login') : T('net_error') + (lastErr ? ': ' + lastErr : ''), 5);
    });
    if (st.authKey) {
      pg.appendAction(T('logout'), function () {
        st.authKey = ''; st.addons = '[]'; _addons = null;
        popup.notify(T('logged_out'), 3);
        pg.redirect(PFX + 'start');
      });
    } else {
      pg.appendItem(PFX + 'login', 'directory', { title: T('phone_login') });
      pg.appendItem(PFX + 'loginmail', 'directory', { title: T('email_login') });
    }
    getAddons().forEach(function (a) {
      pg.appendPassiveItem('separator', '', {
        title: clean(a.m.name) + (a.m.version ? '  v' + clean(a.m.version) : '')
      });
      var types = (a.m.types || []).join(', ');
      var res = [];
      (a.m.resources || []).forEach(function (r) { res.push(typeof r === 'string' ? r : r.name); });
      pg.appendItem(PFX + 'addons', 'directory', {
        title: clean(a.m.description || a.m.id || ''),
        description: clean(types + '  /  ' + res.join(', '))
      });
    });
  });

  // ------------------------------------------------------------------
  // Login: link code (phone/PC approves) and e-mail fallback
  // ------------------------------------------------------------------
  new page.Route('^stremio:login$', function (pg) {
    pg.type = 'directory';
    pg.metadata.title = T('login');
    pg.loading = true;
    var c = fetchJSON(cfg.link + '/api/v2/create?type=Create');
    pg.loading = false;
    if (!c || !c.result || !c.result.code) {
      pg.error(T('link_fail') + (lastErr ? ' - ' + lastErr : ''));
      return;
    }
    var code = c.result.code;
    pg.appendPassiveItem('separator', '', { title: T('link_1') });
    pg.appendPassiveItem('separator', '', { title: String(c.result.link || 'https://link.stremio.com') });
    pg.appendPassiveItem('separator', '', { title: T('link_2') });
    pg.appendPassiveItem('separator', '', { title: String(code) });
    pg.appendPassiveItem('separator', '', { title: T('link_wait') });

    var tries = 0;
    function poll() {
      tries++;
      var r = fetchJSON(cfg.link + '/api/v2/read?type=Read&code=' + enc(code));
      if (r && r.result && r.result.authKey) {
        st.authKey = r.result.authKey;
        var n = syncAddons();
        popup.notify(T('logged_ok') + (typeof n === 'number' ? ' - ' + T('synced') + ': ' + n : ''), 4);
        pg.redirect(PFX + 'start');
        return;
      }
      if (tries < 120) setTimeout(poll, 3000);
    }
    setTimeout(poll, 3000);
  });

  new page.Route('^stremio:loginmail$', function (pg) {
    pg.type = 'directory';
    pg.metadata.title = T('login');
    pg.appendAction(T('email_login'), function () {
      var u = popup.textDialog(T('email') + ':', true, true);
      if (!u || u.rejected || !u.input) return;
      var p = popup.textDialog(T('password') + ':', true, true);
      if (!p || p.rejected || !p.input) return;
      pg.loading = true;
      var r = api('login', { type: 'Auth', email: u.input, password: p.input, facebook: false });
      pg.loading = false;
      if (r && r.result && r.result.authKey) {
        st.authKey = r.result.authKey;
        syncAddons();
        popup.notify(T('logged_ok'), 3);
        pg.redirect(PFX + 'start');
      } else {
        popup.notify((r && r.error && r.error.message) || (T('net_error') + (lastErr ? ': ' + lastErr : '')), 6);
      }
    });
  });

  // ------------------------------------------------------------------
  // Service entry on Movian's home screen + player hints
  // ------------------------------------------------------------------
  service.create('Stremio', PFX + 'start', 'video', true, LOGO);

  try {
    var vs = new (require('movian/videoscrobbler').VideoScrobbler)();
    vs.onstart = function () { popup.notify(T('player_hint'), 6); };
  } catch (e) { /* optional */ }
})();
