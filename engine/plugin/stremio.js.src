/*
 * ps3mio - Stremio engine (built-in plugin)
 * ----------------------------------------
 * Talks to the Stremio API and addons directly. The UI is the ps3mio skin (Stremio look),
 * the player is the Movian engine (libav + PS3 hardware decoder + BitTorrent).
 * ES5 only (Duktape). No external libraries.
 */
(function () {
  var page = require('movian/page');
  var http = require('movian/http');
  var store = require('movian/store');
  var service = require('movian/service');
  var popup = require('native/popup');

  var PFX = 'stremio:';
  var UA = 'ps3mio/0.3 (Stremio client)';
  var VERSION = 'v0.8.0 beta';
  var CINEMETA = 'https://v3-cinemeta.strem.io/manifest.json';
  var SYNC_EVERY_MS = 6 * 3600 * 1000;
  var DEFAULT_TRACKERS = [
    'udp://tracker.opentrackr.org:1337/announce',
    'udp://open.tracker.cl:1337/announce',
    'udp://tracker.torrent.eu.org:451/announce',
    'udp://exodus.desync.com:6969/announce'
  ];

  var I18N = /*I18N*/{};

  var st = store.create('stremio_state');
  var LOGO = (typeof Plugin !== 'undefined' && Plugin.path) ? Plugin.path + 'logo.png' : null;

  // ------------------------------------------------------------------
  // Stremio settings (the app's own settings page, stored in the plugin store)
  // ------------------------------------------------------------------
  var SEEKS = [['5', '5 s'], ['10', '10 s'], ['15', '15 s'], ['20', '20 s'], ['30', '30 s'], ['60', '60 s']];
  var SETTINGS = [
    { section: 'Player', key: 'seekBack', title: 'Seek back step', def: '15', opts: SEEKS },
    { section: 'Player', key: 'seekFwd', title: 'Seek forward step', def: '30', opts: SEEKS },
    { section: 'Player', key: 'resume', title: 'Resume playback', def: '1', opts: [['1', 'Always'], ['2', 'Ask'], ['0', 'Never']] },
    { section: 'Streaming', key: 'maxStreams', title: 'Streams shown per addon', def: '60', opts: [['20', '20'], ['40', '40'], ['60', '60'], ['100', '100']] },
    { section: 'Advanced', key: 'relay', title: 'HTTP relay prefix (only if HTTPS fails)', def: '', text: true },
    { section: 'Advanced', key: 'manual', title: 'Extra addon manifest URLs', def: '', text: true },
    { section: 'Advanced', key: 'log', title: 'Enable log', def: '1', opts: [['1', 'On'], ['0', 'Off']] }
  ];

  // Settings > Buttons info (PS3 pad; on the phone test build the same actions use touch / the on-screen text)
  var BUTTONS = [
    ['X', 'Select / open'],
    ['O', 'Back'],
    ['Triangle', 'Menu'],
    ['Square', 'Options / info'],
    ['START', 'Play / pause'],
    ['L1 / R1', 'Skip'],
    ['Left / Right', 'Seek (steps set in Player settings)']
  ];

  function settingOf(key) {
    for (var i = 0; i < SETTINGS.length; i++) if (SETTINGS[i].key === key) return SETTINGS[i];
    return null;
  }
  function cfgGet(key) {
    var s = settingOf(key);
    var v = st['cfg_' + key];
    return (v === undefined || v === null || v === '') ? (s ? s.def : '') : String(v);
  }
  function cfgSet(key, v) {
    st['cfg_' + key] = String(v);
    if (key === 'manual') _addons = null;
    if (key === 'log') applyLog();
  }
  // Settings > Enable log: tells the engine (global.ps3mio.log) whether to write log.txt
  function applyLog() {
    try {
      require('movian/prop').global.ps3mio.log = (cfgGet('log') === '0') ? 0 : 1;
    } catch (e) {
      console.log('ps3mio: cannot set the log switch: ' + e);
    }
  }
  var cfg = { api: 'https://api.strem.io', link: 'https://link.stremio.com' };
  ['relay', 'manual'].forEach(function (k) {
    Object.defineProperty(cfg, k, { get: function () { return cfgGet(k); } });
  });
  ['maxStreams', 'seekBack', 'seekFwd', 'resume'].forEach(function (k) {
    Object.defineProperty(cfg, k, { get: function () { return parseInt(cfgGet(k), 10); } });
  });

  // ------------------------------------------------------------------
  // Helpers
  // ------------------------------------------------------------------
  var lastErr = '';
  var _addons = null;
  var metaCache = {};
  var metaCacheKeys = [];

  function T(k) {
    var d = I18N.en || {};
    return d[k] || k;
  }

  function clean(s) {
    if (s === undefined || s === null) return '';
    return String(s)
      .replace(/[\uD800-\uDFFF]/g, '')
      .replace(/[\u2190-\u2BFF\uFE0F\u200D]/g, '')
      .replace(/[ \t]+/g, ' ')
      .replace(/^\s+|\s+$/g, '');
  }

  function oneLine(s) { return clean(s).replace(/\s*[\r\n]+\s*/g, ' | '); }

  function firstLine(s) { return clean(s).split(/[\r\n]+/)[0] || ''; }

  function viaRelay(url) {
    if (cfg.relay && /^https?:/i.test(url)) return cfg.relay + encodeURIComponent(url);
    return url;
  }

  function fetchJSON(url, opt) {
    opt = opt || {};
    var ctrl = {
      headers: { 'User-Agent': UA, 'Accept': 'application/json' },
      compression: true,
      noFail: true
    };
    if (opt.cache) { ctrl.caching = true; ctrl.cacheTime = opt.cache; }
    if (opt.post !== undefined) {
      ctrl.postdata = JSON.stringify(opt.post);
      ctrl.headers['Content-Type'] = 'application/json';
    }
    try {
      var r = http.request(viaRelay(url), ctrl);
      var txt = r.toString();
      if (!txt) { lastErr = 'empty response (' + r.statuscode + ')'; return null; }
      return JSON.parse(txt);
    } catch (e) {
      lastErr = String(e);
      return null;
    }
  }

  function api(method, body) {
    return fetchJSON(cfg.api + '/api/' + method, { post: body });
  }

  function enc(s) { return encodeURIComponent(s); }

  function encId(id) { return enc(id).replace(/%3A/gi, ':'); }

  function decode(s) { try { return decodeURIComponent(s); } catch (e) { return s; } }

  function slim(m) {
    var cats = [];
    (m.catalogs || []).forEach(function (c) {
      cats.push({ type: c.type, id: c.id, name: c.name, extra: c.extra,
                  extraSupported: c.extraSupported, extraRequired: c.extraRequired });
    });
    return { id: m.id, name: m.name, version: m.version, description: m.description,
             types: m.types, idPrefixes: m.idPrefixes, resources: m.resources,
             catalogs: cats };
  }

  function baseOf(url) {
    return String(url).replace(/\/manifest\.json.*$/, '').replace(/\/+$/, '');
  }

  function syncAddons() {
    if (!st.authKey) return 'login';
    var r = api('addonCollectionGet',
                { type: 'AddonCollectionGet', authKey: st.authKey, update: true });
    if (!r || !r.result || !r.result.addons) {
      if (r && r.error) lastErr = (r.error.message || 'api error');
      return 'error';
    }
    var out = [];
    r.result.addons.forEach(function (a) {
      if (a && a.manifest && a.transportUrl) out.push({ url: a.transportUrl, m: slim(a.manifest) });
    });
    st.addons = JSON.stringify(out);
    st.syncedAt = String(new Date().getTime());
    _addons = null;
    return out.length;
  }

  function getAddons() {
    if (_addons) return _addons;
    var list = [];
    try { list = JSON.parse(st.addons || '[]'); } catch (e) { list = []; }
    var seen = {};
    list.forEach(function (a) { seen[a.url] = 1; });
    String(cfg.manual || '').split(/[\s,]+/).forEach(function (u) {
      if (!u || seen[u]) return;
      var m = fetchJSON(u, { cache: 3600 });
      if (m && m.id) { list.push({ url: u, m: slim(m) }); seen[u] = 1; }
    });
    if (!list.length) {
      var cm = fetchJSON(CINEMETA, { cache: 3600 });
      if (cm && cm.id) list.push({ url: CINEMETA, m: slim(cm) });
    }
    list.forEach(function (a) { a.base = baseOf(a.url); });
    _addons = list;
    return list;
  }

  function resInfo(m, name) {
    var rs = m.resources || [];
    for (var i = 0; i < rs.length; i++) {
      var r = rs[i];
      if (typeof r === 'string') {
        if (r === name) return { types: m.types, idPrefixes: m.idPrefixes };
      } else if (r && r.name === name) {
        return { types: r.types || m.types, idPrefixes: r.idPrefixes || m.idPrefixes };
      }
    }
    return null;
  }

  function supports(a, res, type, id) {
    var ri = resInfo(a.m, res);
    if (!ri) return false;
    if (ri.types && ri.types.length) {
      var ok = false;
      for (var i = 0; i < ri.types.length; i++) if (ri.types[i] === type) ok = true;
      if (!ok) return false;
    }
    if (ri.idPrefixes && ri.idPrefixes.length && id) {
      var ok2 = false;
      for (var j = 0; j < ri.idPrefixes.length; j++)
        if (String(id).indexOf(ri.idPrefixes[j]) === 0) ok2 = true;
      if (!ok2) return false;
    }
    return true;
  }

  function resUrl(a, res, type, id) {
    return a.base + '/' + res + '/' + type + '/' + encId(id) + '.json';
  }

  function catInfo(c) {
    var sup = {}, req = {}, genres = null;
    (c.extra || []).forEach(function (e) {
      sup[e.name] = 1;
      if (e.isRequired) req[e.name] = 1;
      if (e.name === 'genre' && e.options && e.options.length) genres = e.options;
    });
    (c.extraSupported || []).forEach(function (n) { sup[n] = 1; });
    (c.extraRequired || []).forEach(function (n) { req[n] = 1; });
    return { sup: sup, req: req, genres: genres };
  }

  function browsable(c) {
    var i = catInfo(c);
    for (var k in i.req) if (k !== 'genre' && k !== 'skip') return false;
    return true;
  }

  function catUrl(a, c, extra) {
    var p = [];
    for (var k in extra) {
      if (extra[k] !== undefined && extra[k] !== null && extra[k] !== '')
        p.push(k + '=' + enc(extra[k]));
    }
    return a.base + '/catalog/' + c.type + '/' + enc(c.id) +
      (p.length ? '/' + p.join('&') : '') + '.json';
  }

  function typeName(t) {
    if (t === 'movie') return T('movie');
    if (t === 'series') return T('series');
    if (t === 'channel') return T('channel');
    return t;
  }

  function catTitle(a, c) {
    return clean(c.name || c.id) + ' - ' + typeName(c.type) + '  [' + clean(a.m.name) + ']';
  }

  function img(u) { return u ? viaRelay(u) : undefined; }

  function metaTitle(m) {
    var t = clean(m.name || m.id);
    if (m.releaseInfo) t += ' (' + clean(m.releaseInfo) + ')';
    else if (m.year) t += ' (' + m.year + ')';
    return t;
  }

  function appendMeta(pg, m, fallbackType) {
    var type = m.type || fallbackType;
    var md = { title: metaTitle(m), icon: img(m.poster || m.logo) };
    var d = [];
    if (m.imdbRating) { md.rating = Math.round(parseFloat(m.imdbRating) * 10); d.push('IMDb ' + m.imdbRating); }
    if (m.genres && m.genres.length) d.push(clean(m.genres.join(', ')));
    if (m.description) d.push(clean(m.description));
    md.description = d.join('\n');
    return pg.appendItem(PFX + 'meta:' + type + ':' + enc(m.id), 'directory', md);
  }

  function refreshAll() {
    metaCache = {};
    metaCacheKeys = [];
    _addons = null;
    var n = st.authKey ? syncAddons() : 'login';
    return n;
  }

  function getRecents() {
    try { var r = JSON.parse(st.recent || '[]'); return r.length ? r : []; } catch (e) { return []; }
  }

  function addRecent(q) {
    var r = getRecents(), out = [q];
    r.forEach(function (x) { if (x !== q && out.length < 8) out.push(x); });
    st.recent = JSON.stringify(out);
  }

  function getMeta(type, id) {
    var key = type + '|' + id;
    if (metaCache[key]) return metaCache[key];
    var addons = getAddons();
    for (var i = 0; i < addons.length; i++) {
      if (!supports(addons[i], 'meta', type, id)) continue;
      var r = fetchJSON(resUrl(addons[i], 'meta', type, id), { cache: 300 });
      if (r && r.meta) {
        metaCache[key] = r.meta;
        metaCacheKeys.push(key);
        if (metaCacheKeys.length > 4) delete metaCache[metaCacheKeys.shift()];
        return r.meta;
      }
    }
    return null;
  }

  function seasonsOf(meta) {
    var map = {}, list = [];
    (meta.videos || []).forEach(function (v) {
      var s = (v.season === undefined || v.season === null) ? 0 : parseInt(v.season, 10);
      if (isNaN(s)) s = 0;
      if (!map[s]) { map[s] = []; list.push(s); }
      map[s].push(v);
    });
    list.sort(function (x, y) { return x - y; });
    list.forEach(function (s) {
      map[s].sort(function (x, y) {
        return (parseInt(x.episode || x.number || 0, 10)) - (parseInt(y.episode || y.number || 0, 10));
      });
    });
    return { list: list, map: map };
  }

  function metaDescription(m) {
    var d = [];
    var head = [];
    if (m.releaseInfo || m.year) head.push(clean(m.releaseInfo || m.year));
    if (m.runtime) head.push(clean(m.runtime));
    if (m.imdbRating) head.push('IMDb ' + m.imdbRating);
    if (head.length) d.push(head.join('  -  '));
    if (m.genres && m.genres.length) d.push(clean(m.genres.join(', ')));
    if (m.description) d.push(clean(m.description));
    if (m.director && m.director.length) d.push(T('director') + ': ' + clean([].concat(m.director).join(', ')));
    if (m.cast && m.cast.length) d.push(T('cast') + ': ' + clean(m.cast.slice(0, 8).join(', ')));
    return d.join('\n');
  }

  function magnetOf(s, title, se) {
    var m = 'magnet:?xt=urn:btih:' + s.infoHash;
    if (title) m += '&dn=' + enc(title);
    var trackers = [];
    (s.sources || []).forEach(function (x) {
      if (typeof x === 'string' && x.indexOf('tracker:') === 0) trackers.push(x.substr(8));
    });
    if (!trackers.length) trackers = DEFAULT_TRACKERS;
    trackers.forEach(function (t) { m += '&tr=' + enc(t); });
    // m7io extensions understood by the patched bittorrent backend: pick the right file of a pack
    if (s.fileIdx !== undefined && s.fileIdx !== null && !isNaN(parseInt(s.fileIdx, 10))) m += '&m7idx=' + parseInt(s.fileIdx, 10);
    else if (se) m += '&m7se=' + se.season + ':' + se.episode;
    return m;
  }

  function mapEmoji(t) {
    return String(t === undefined || t === null ? '' : t)
      .replace(/\uD83D\uDC64/g, 'Seeds ')
      .replace(/\uD83D\uDC65/g, 'Peers ')
      .replace(/\uD83D\uDCBE/g, 'Size ')
      .replace(/\u2699\uFE0F?/g, 'Src ');
  }

  function fmtSize(b) {
    b = parseFloat(b);
    if (isNaN(b) || b <= 0) return '';
    if (b >= 1073741824) return (b / 1073741824).toFixed(2) + ' GB';
    if (b >= 1048576) return Math.round(b / 1048576) + ' MB';
    return Math.round(b / 1024) + ' KB';
  }

  function codecOf(str) {
    str = String(str || '');
    if (/(x\.?265|h\.?265|hevc)/i.test(str)) return 'x265';
    if (/(x\.?264|h\.?264|avc)/i.test(str)) return 'x264';
    if (/\bav1\b/i.test(str)) return 'AV1';
    return '';
  }

  // Row layout: title = release / file name, line under it = Seeds | Size | codec
  function streamRow(a, s) {
    var nameLines = clean(mapEmoji(s.name || a.m.name)).split(/[\r\n]+/);
    var qual = nameLines.slice(1).join(' ');
    var text = clean(mapEmoji(s.title || s.description || ''));
    var bh = s.behaviorHints || {};
    var seedM = /Seeds\s*(\d+)/i.exec(text);
    var sizeM = /Size\s*([\d.,]+\s*[KMGT]i?B)/i.exec(text);
    var seeders = seedM ? parseInt(seedM[1], 10) : ((s.seeders !== undefined && s.seeders !== null) ? parseInt(s.seeders, 10) : null);
    var size = sizeM ? sizeM[1] : fmtSize(bh.videoSize);
    var fname = clean(bh.filename || text.split(/[\r\n]+/)[0] || '');
    if (/^(Seeds|Peers|Size|Src)\b/i.test(fname)) fname = '';
    if (fname.length > 110) fname = fname.substr(0, 107) + '...';
    var codec = codecOf(fname + ' ' + text + ' ' + nameLines.join(' '));
    var info = [];
    if (seeders !== null && !isNaN(seeders)) info.push('Seeds ' + seeders);
    if (size) info.push(size);
    if (codec) info.push(codec);
    var title = (qual ? '[' + qual + '] ' : '') + (fname || oneLine(nameLines[0] || a.m.name));
    return { title: title, description: info.join('   |   '), seeders: seeders, size: size, codec: codec };
  }

  function gatherSubs(type, id) {
    var out = [];
    getAddons().forEach(function (a) {
      if (!supports(a, 'subtitles', type, id)) return;
      var r = fetchJSON(resUrl(a, 'subtitles', type, id), { cache: 300 });
      if (!r || !r.subtitles) return;
      r.subtitles.slice(0, 12).forEach(function (x) {
        if (!x.url) return;
        out.push({ title: clean(x.lang || 'sub') + ' - ' + clean(a.m.name),
                   url: x.url, language: x.lang, source: clean(a.m.name) });
      });
    });
    return dedupeSubs(out).slice(0, 24);
  }

  // The same subtitle URL can arrive from two addons (or from the stream itself). Movian identifies
  // a track by its URL, so duplicates made the menu show two entries selected at once.
  function dedupeSubs(list) {
    var seen = {}, out = [];
    list.forEach(function (x) {
      if (!x || !x.url || seen[x.url]) return;
      seen[x.url] = 1;
      out.push(x);
    });
    return out;
  }

  function seasonEpisodeOf(id) {
    var p = String(id).split(':');
    if (p.length >= 3) {
      var s = parseInt(p[p.length - 2], 10), e = parseInt(p[p.length - 1], 10);
      if (!isNaN(s) && !isNaN(e)) return { season: s, episode: e };
    }
    return null;
  }

  function loadLibrary() {
    if (!st.authKey) return null;
    var r = api('datastoreGet', { authKey: st.authKey, collection: 'libraryItem', ids: [], all: true });
    if (!r || !r.result) return null;
    var out = [];
    r.result.forEach(function (it) { if (it && !it.removed) out.push(it); });
    out.sort(function (x, y) { return String(y._mtime || '').localeCompare(String(x._mtime || '')); });
    return out;
  }

  // ------------------------------------------------------------------
  // Model helpers for the ps3mio skin pages (board rows, filters, details)
  // ------------------------------------------------------------------
  function nodeItem(node, url, title, icon) {
    node.url = url;
    node.type = 'directory';
    node.metadata.title = title;
    if (icon) node.metadata.icon = icon;
  }

  function writeRow(pg, idx, title, metas, fallbackType) {
    var r = pg.model.rows['r' + idx];
    r.title = title;
    for (var k = 0; k < metas.length; k++) {
      var m = metas[k];
      nodeItem(r.items['i' + k], PFX + 'meta:' + (m.type || fallbackType) + ':' + enc(m.id),
        metaTitle(m), img(m.poster || m.logo));
    }
  }

  function setFilter(pg, id, title, url) {
    var f = pg.model.filters[id];
    f.title = title;
    f.url = url;
  }

  function setNav(pg, type, nav, title) {
    pg.type = type;
    pg.metadata.nav = nav;
    pg.metadata.title = title;
  }

  new page.Route('^stremio:refresh$', function (pg) {
    setNav(pg, 'slist', 'board', T('refresh'));
    pg.loading = true;
    var n = refreshAll();
    pg.loading = false;
    if (typeof n === 'number') popup.notify(T('synced') + ': ' + n, 3);
    else if (n === 'error') popup.notify(T('net_error') + (lastErr ? ': ' + lastErr : ''), 5);
    pg.redirect(PFX + 'start');
  });

  // ------------------------------------------------------------------
  // Board (home): Continue Watching + one row per addon catalog
  // ------------------------------------------------------------------
  new page.Route('^stremio:start$', function (pg) {
    setNav(pg, 'sboard', 'board', 'ps3mio');
    pg.loading = true;
    if (st.authKey) {
      var last = parseInt(st.syncedAt || '0', 10);
      if (!last || new Date().getTime() - last > SYNC_EVERY_MS) syncAddons();
    } else {
      setFilter(pg, 'login', T('phone_login'), PFX + 'login');
    }
    var addons = getAddons();
    var n = 0;
    if (st.authKey) {
      var lib = loadLibrary() || [];
      var cont = [];
      lib.forEach(function (it) {
        var s = it.state || {};
        if (s.timeOffset > 0) cont.push({ id: it._id, type: it.type, name: it.name, poster: it.poster });
      });
      if (cont.length) writeRow(pg, n++, T('cw'), cont.slice(0, 20), 'movie');
    }
    var rows = 0;
    addons.forEach(function (a) {
      (a.m.catalogs || []).forEach(function (c) {
        if (rows >= 10 || !browsable(c)) return;
        var info = catInfo(c);
        var extra = {};
        if (info.req.genre && info.genres && info.genres.length) extra.genre = info.genres[0];
        var r = fetchJSON(catUrl(a, c, extra), { cache: 120 });
        if (!r || !r.metas || !r.metas.length) return;
        writeRow(pg, n++, clean(c.name || c.id) + ' - ' + typeName(c.type), r.metas.slice(0, 20), c.type);
        rows++;
      });
    });
    pg.loading = false;
    if (!n) pg.metadata.notice = lastErr ? T('net_error') + ': ' + lastErr : T('no_results');
  });

  // ------------------------------------------------------------------
  // Discover (type / catalog / genre filters + paged poster grid)
  // ------------------------------------------------------------------
  function typeRank(t) { return t === 'movie' ? 0 : (t === 'series' ? 1 : 2); }

  function fillGrid(pg, a, c, genre) {
    var info = catInfo(c);
    var skip = 0;
    var canSkip = !!info.sup.skip;
    pg.loading = true;
    function load() {
      var extra = {};
      if (genre) extra.genre = genre;
      if (skip) extra.skip = skip;
      var r = fetchJSON(catUrl(a, c, extra), { cache: 120 });
      pg.loading = false;
      if (!r || !r.metas) {
        if (!skip) pg.metadata.notice = T('net_error') + (lastErr ? ': ' + lastErr : '');
        pg.haveMore(false);
        return;
      }
      r.metas.forEach(function (m) { appendMeta(pg, m, c.type); });
      skip += r.metas.length;
      pg.haveMore(canSkip && r.metas.length > 0);
    }
    pg.asyncPaginator = load;
    load();
  }

  new page.Route('^stremio:discover$', function (pg) {
    pg.redirect(PFX + 'discover:0:0:0');
  });

  new page.Route('^stremio:discover:(\\d+):(\\d+):(\\d+)$', function (pg, t0, c0, g0) {
    setNav(pg, 'sgrid', 'discover', T('discover'));
    pg.loading = true;
    var all = [];
    getAddons().forEach(function (a) {
      (a.m.catalogs || []).forEach(function (c) { if (browsable(c)) all.push({ a: a, c: c }); });
    });
    var types = [];
    all.forEach(function (e) { if (types.indexOf(e.c.type) < 0) types.push(e.c.type); });
    types.sort(function (x, y) { return typeRank(x) - typeRank(y); });
    if (!types.length) {
      pg.loading = false;
      pg.metadata.notice = lastErr ? T('net_error') + ': ' + lastErr : T('no_results');
      return;
    }
    var ti = Math.min(parseInt(t0, 10), types.length - 1);
    var entries = all.filter(function (e) { return e.c.type === types[ti]; });
    var ci = Math.min(parseInt(c0, 10), entries.length - 1);
    var e = entries[ci];
    var info = catInfo(e.c);
    var genres = info.req.genre ? [] : [''];
    genres = genres.concat(info.genres || []);
    var gi = Math.min(parseInt(g0, 10), Math.max(genres.length - 1, 0));
    var genre = genres[gi] || '';
    setFilter(pg, 'f0', T('Type') + ': ' + typeName(types[ti]), PFX + 'discover:' + ((ti + 1) % types.length) + ':0:0');
    setFilter(pg, 'f1', T('Catalog') + ': ' + clean(e.c.name || e.c.id) + ' [' + clean(e.a.m.name) + ']',
      PFX + 'discover:' + ti + ':' + ((ci + 1) % entries.length) + ':0');
    if (genres.length > 1) {
      setFilter(pg, 'f2', T('genre') + ': ' + (genre || T('all')),
        PFX + 'discover:' + ti + ':' + ci + ':' + ((gi + 1) % genres.length));
    }
    fillGrid(pg, e.a, e.c, genre);
  });

  // ------------------------------------------------------------------
  // Library
  // ------------------------------------------------------------------
  new page.Route('^stremio:library$', function (pg) {
    setNav(pg, 'sgrid', 'library', T('library'));
    pg.loading = true;
    var items = loadLibrary();
    pg.loading = false;
    if (!items) {
      pg.metadata.notice = st.authKey ? T('net_error') + (lastErr ? ': ' + lastErr : '') : T('need_login');
      return;
    }
    if (!items.length) pg.metadata.notice = T('no_results');
    items.forEach(function (it) {
      appendMeta(pg, { id: it._id, type: it.type, name: it.name, poster: it.poster }, it.type);
    });
  });

  // ------------------------------------------------------------------
  // Search
  // ------------------------------------------------------------------
  function searchRows(pg, query) {
    var n = 0;
    pg.loading = true;
    getAddons().forEach(function (a) {
      (a.m.catalogs || []).forEach(function (c) {
        if (!catInfo(c).sup.search) return;
        var r = fetchJSON(catUrl(a, c, { search: query }), { cache: 60 });
        if (!r || !r.metas || !r.metas.length) return;
        writeRow(pg, n++, clean(c.name || c.id) + ' - ' + typeName(c.type) + ' [' + clean(a.m.name) + ']',
          r.metas.slice(0, 24), c.type);
      });
    });
    pg.loading = false;
    if (!n) pg.metadata.notice = T('no_results');
  }

  new page.Route('^stremio:searchbox$', function (pg) {
    setNav(pg, 'slist', 'search', T('search'));
    pg.appendItem(PFX + 'dosearch', 'directory', { title: T('search_btn') });
    var rec = getRecents();
    if (rec.length) pg.appendPassiveItem('separator', '', { title: T('recent') });
    rec.forEach(function (q) { pg.appendItem(PFX + 'q:' + enc(q), 'directory', { title: clean(q) }); });
  });

  new page.Route('^stremio:dosearch$', function (pg) {
    setNav(pg, 'slist', 'search', T('search'));
    var r = popup.textDialog(T('search') + ':', true, true);
    if (r && !r.rejected && r.input) {
      addRecent(r.input);
      pg.redirect(PFX + 'q:' + enc(r.input));
    } else {
      pg.redirect(PFX + 'searchbox');
    }
  });

  new page.Route('^stremio:q:(.*)$', function (pg, q) {
    var query = decode(q);
    setNav(pg, 'sboard', 'search', T('search') + ': ' + query);
    searchRows(pg, query);
  });

  new page.Searcher('Stremio', LOGO, function (pg, query) {
    pg.type = 'directory';
    getAddons().forEach(function (a) {
      (a.m.catalogs || []).forEach(function (c) {
        if (!catInfo(c).sup.search) return;
        var r = fetchJSON(catUrl(a, c, { search: query }), { cache: 60 });
        if (r && r.metas) r.metas.slice(0, 30).forEach(function (m) { appendMeta(pg, m, c.type); });
      });
    });
  });

  // ------------------------------------------------------------------
  // Detail page -> seasons -> episodes -> streams
  // ------------------------------------------------------------------
  new page.Route('^stremio:meta:([^:]+):(.+)$', function (pg, type, eid) {
    var id = decode(eid);
    pg.type = 'sdetail';
    pg.loading = true;
    var meta = getMeta(type, id);
    pg.loading = false;
    if (!meta) {
      pg.metadata.title = id;
      pg.appendItem(PFX + 'streams:' + type + ':' + eid + ':' + enc(id), 'directory', { title: T('watch') });
      return;
    }
    var name = clean(meta.name || id);
    pg.metadata.title = name;
    if (meta.poster) pg.metadata.icon = img(meta.poster);
    if (meta.logo) pg.metadata.logo = img(meta.logo);
    if (meta.background) pg.metadata.background = img(meta.background);
    var info = [];
    if (meta.releaseInfo || meta.year) info.push(clean(meta.releaseInfo || meta.year));
    if (meta.runtime) info.push(clean(meta.runtime));
    if (meta.imdbRating) info.push('IMDb ' + meta.imdbRating);
    pg.metadata.info = info.join('    ');
    if (meta.genres && meta.genres.length) pg.metadata.genres = clean(meta.genres.join(', '));
    var desc = clean(meta.description || '');
    if (desc.length > 700) desc = desc.substr(0, 697) + '...';
    pg.metadata.description = desc;
    if (meta.cast && meta.cast.length) pg.metadata.cast = T('cast') + ': ' + clean(meta.cast.slice(0, 8).join(', '));

    var seasons = (type !== 'movie' && meta.videos && meta.videos.length) ? seasonsOf(meta) : null;
    if (!seasons) {
      pg.appendItem(PFX + 'streams:' + type + ':' + eid + ':' + enc(meta.name || id), 'directory',
        { title: T('watch') });
      return;
    }
    seasons.list.forEach(function (s) {
      pg.appendItem(PFX + 'season:' + type + ':' + eid + ':' + s, 'directory', {
        title: (s === 0 ? T('special') : T('season') + ' ' + s) + '  (' + seasons.map[s].length + ')'
      });
    });
  });

  new page.Route('^stremio:season:([^:]+):([^:]+):(\\d+)$', function (pg, type, eid, s) {
    var id = decode(eid);
    var meta = getMeta(type, id);
    var sn = parseInt(s, 10);
    setNav(pg, 'slist', 'board', clean(meta ? meta.name : id) + ' - ' + (sn === 0 ? T('special') : T('season') + ' ' + s));
    if (!meta) return;
    var seasons = seasonsOf(meta);
    (seasons.map[sn] || []).forEach(function (v) {
      var ep = v.episode || v.number;
      var title = (ep ? ep + '. ' : '') + clean(v.title || v.name || T('episode'));
      var d = [];
      if (v.released) d.push(String(v.released).substr(0, 10));
      if (v.overview || v.description) d.push(clean(v.overview || v.description));
      var md = { title: title, description: d.join('  -  ') };
      if (v.thumbnail) md.icon = img(v.thumbnail);
      pg.appendItem(PFX + 'streams:' + type + ':' + enc(v.id) + ':' +
        enc(clean(meta.name) + ' S' + sn + 'E' + (ep || '?')), 'directory', md);
    });
  });

  // ------------------------------------------------------------------
  // Streams
  // ------------------------------------------------------------------
  new page.Route('^stremio:streams:([^:]+):([^:]+):(.*)$', function (pg, type, eid, etitle) {
    var id = decode(eid);
    var title = decode(etitle) || id;
    setNav(pg, 'slist', 'board', clean(title));
    pg.loading = true;

    var subs = null;
    var se = (type === 'series') ? seasonEpisodeOf(id) : null;
    var baseId = se ? id.split(':').slice(0, -2).join(':') : id;
    var m0 = metaCache[type + '|' + baseId] || null;
    var total = 0;

    function videoItem(url, row, s) {
      if (subs === null) subs = gatherSubs(type, id);
      var vp = {
        title: clean(title),
        canonicalUrl: url,
        sources: [{ url: url }],
        subtitles: dedupeSubs((s.subtitles && s.subtitles.length ? s.subtitles.map(function (x) {
          return { title: clean(x.lang || 'sub'), url: x.url, language: x.lang, source: 'stream' };
        }) : []).concat(subs)),
        no_fs_scan: 1,
        no_subtitle_scan: 1,
        ps3mio: { seekBack: cfg.seekBack, seekFwd: cfg.seekFwd, resume: cfg.resume }
      };
      if (m0 && m0.logo) vp.logo = img(m0.logo);
      if (m0 && (m0.background || m0.poster)) vp.backdrop = img(m0.background || m0.poster);
      if (se) { vp.season = se.season; vp.episode = se.episode; }
      pg.appendItem('videoparams:' + JSON.stringify(vp), 'video',
        { title: row.title, description: row.description });
    }

    getAddons().forEach(function (a) {
      if (!supports(a, 'stream', type, id)) return;
      var r = fetchJSON(resUrl(a, 'stream', type, id), { cache: 30 });
      if (!r || !r.streams || !r.streams.length) return;
      var added = 0;
      r.streams.slice(0, cfg.maxStreams).forEach(function (s) {
        var row = streamRow(a, s);
        var url = null;
        if (s.url && /^magnet:/i.test(s.url)) {
          url = 'torrent:video:' + s.url;
        } else if (s.infoHash) {
          url = 'torrent:video:' + magnetOf(s, title, se);
        } else if (s.url && /^https?:/i.test(s.url)) {
          url = viaRelay(s.url);
        }
        if (!url) return;
        if (!added) pg.appendPassiveItem('separator', '', { title: clean(a.m.name) });
        videoItem(url, row, s);
        added++; total++;
      });
    });
    pg.loading = false;
    if (!total) pg.appendPassiveItem('separator', '', { title: T('no_streams') });
  });

  // ------------------------------------------------------------------
  // Addons (read-only; edit them from your phone or PC)
  // ------------------------------------------------------------------
  new page.Route('^stremio:addons$', function (pg) {
    setNav(pg, 'slist', 'addons', T('addons'));
    pg.appendPassiveItem('separator', '', { title: T('addons_help') });
    pg.appendItem(PFX + 'refresh', 'directory', { title: T('sync') });
    if (!st.authKey) {
      pg.appendItem(PFX + 'login', 'directory', { title: T('phone_login') });
      pg.appendItem(PFX + 'loginmail', 'directory', { title: T('email_login') });
    }
    getAddons().forEach(function (a) {
      var res = [];
      (a.m.resources || []).forEach(function (r) { res.push(typeof r === 'string' ? r : r.name); });
      var md = {
        title: clean(a.m.name) + (a.m.version ? '   v' + clean(a.m.version) : ''),
        description: clean(a.m.description || '') + (res.length ? '   [' + res.join(', ') + ']' : '')
      };
      pg.appendItem(PFX + 'addons', 'directory', md);
    });
  });

  // ------------------------------------------------------------------
  // Settings (Stremio-style settings page; values live in the plugin store)
  // ------------------------------------------------------------------
  function valueLabel(s) {
    var v = cfgGet(s.key);
    if (s.text) return v ? v : '-';
    for (var i = 0; i < s.opts.length; i++) if (s.opts[i][0] === v) return s.opts[i][1];
    return v;
  }

  new page.Route('^stremio:settings$', function (pg) {
    setNav(pg, 'slist', 'settings', T('settings'));
    pg.appendPassiveItem('separator', '', { title: T('Account') });
    pg.appendItem(PFX + 'settings', 'directory', { title: st.authKey ? T('logged_ok') : T('not_logged') });
    if (st.authKey) {
      pg.appendItem(PFX + 'logout', 'directory', { title: T('logout') });
    } else {
      pg.appendItem(PFX + 'login', 'directory', { title: T('phone_login') });
      pg.appendItem(PFX + 'loginmail', 'directory', { title: T('email_login') });
    }
    pg.appendItem(PFX + 'refresh', 'directory', { title: T('sync') });
    var sec = '';
    SETTINGS.forEach(function (s) {
      if (s.section !== sec) {
        sec = s.section;
        pg.appendPassiveItem('separator', '', { title: T(sec) });
      }
      pg.appendItem(PFX + 'cfg:' + s.key, 'directory', { title: T(s.title) + ':   ' + valueLabel(s) });
    });
    pg.appendPassiveItem('separator', '', { title: T('Buttons info') });
    BUTTONS.forEach(function (b) {
      pg.appendItem(PFX + 'settings', 'directory', { title: b[0], description: b[1] });
    });
    pg.appendPassiveItem('separator', '', { title: T('Info') });
    pg.appendItem(PFX + 'settings', 'directory', { title: 'ps3mio ' + VERSION + '  -  Stremio client' });
  });

  new page.Route('^stremio:cfg:(.+)$', function (pg, key) {
    setNav(pg, 'slist', 'settings', T('settings'));
    var s = settingOf(key);
    if (s) {
      if (s.text) {
        var r = popup.textDialog(T(s.title) + ':', true, true);
        if (r && !r.rejected && typeof r.input === 'string') cfgSet(key, r.input);
      } else {
        var cur = cfgGet(key), idx = -1;
        for (var i = 0; i < s.opts.length; i++) if (s.opts[i][0] === cur) idx = i;
        cfgSet(key, s.opts[(idx + 1) % s.opts.length][0]);
      }
    }
    pg.redirect(PFX + 'settings');
  });

  new page.Route('^stremio:logout$', function (pg) {
    setNav(pg, 'slist', 'settings', T('settings'));
    st.authKey = '';
    st.addons = '[]';
    _addons = null;
    popup.notify(T('logged_out'), 3);
    pg.redirect(PFX + 'start');
  });

  // ------------------------------------------------------------------
  // Login: link code (phone / PC approves) and e-mail fallback
  // ------------------------------------------------------------------
  new page.Route('^stremio:login$', function (pg) {
    setNav(pg, 'slist', 'settings', T('login'));
    pg.loading = true;
    var c = fetchJSON(cfg.link + '/api/v2/create?type=Create');
    pg.loading = false;
    if (!c || !c.result || !c.result.code) {
      pg.metadata.notice = T('link_fail') + (lastErr ? ' - ' + lastErr : '');
      return;
    }
    var code = c.result.code;
    pg.appendPassiveItem('separator', '', { title: T('link_1') });
    pg.appendItem(PFX + 'login', 'directory', { title: String(c.result.link || 'https://link.stremio.com') });
    pg.appendPassiveItem('separator', '', { title: T('link_2') });
    pg.appendItem(PFX + 'login', 'directory', { title: String(code) });
    pg.appendPassiveItem('separator', '', { title: T('link_wait') });

    var tries = 0;
    function poll() {
      tries++;
      var r = fetchJSON(cfg.link + '/api/v2/read?type=Read&code=' + enc(code));
      if (r && r.result && r.result.authKey) {
        st.authKey = r.result.authKey;
        var n = syncAddons();
        popup.notify(T('logged_ok') + (typeof n === 'number' ? ' - ' + T('synced') + ': ' + n : ''), 4);
        pg.redirect(PFX + 'start');
        return;
      }
      if (tries < 120) setTimeout(poll, 3000);
    }
    setTimeout(poll, 3000);
  });

  new page.Route('^stremio:loginmail$', function (pg) {
    setNav(pg, 'slist', 'settings', T('login'));
    var u = popup.textDialog(T('email') + ':', true, true);
    var p = (u && !u.rejected && u.input) ? popup.textDialog(T('password') + ':', true, true) : null;
    if (u && p && !u.rejected && !p.rejected && u.input && p.input) {
      pg.loading = true;
      var r = api('login', { type: 'Auth', email: u.input, password: p.input, facebook: false });
      pg.loading = false;
      if (r && r.result && r.result.authKey) {
        st.authKey = r.result.authKey;
        syncAddons();
        popup.notify(T('logged_ok'), 3);
        pg.redirect(PFX + 'start');
        return;
      }
      popup.notify((r && r.error && r.error.message) || (T('net_error') + (lastErr ? ': ' + lastErr : '')), 6);
    }
    pg.redirect(PFX + 'settings');
  });

  applyLog();
  service.create('Stremio', PFX + 'start', 'video', true, LOGO);
})();
